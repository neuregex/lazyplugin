# Set the key for whichever provider you want to use. You need exactly one.
# Local models (Ollama, LM Studio, vLLM) need no key at all.

DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=

# Default model, as provider/model. Override per run with --model.
# LAZYPLUGIN_MODEL=deepseek/deepseek-v4-flash

# Only if Maven is not on your PATH.
# LAZYPLUGIN_MAVEN=/opt/maven/bin/mvn
